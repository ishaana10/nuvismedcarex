# ClinicFlow Apache Configuration
AddType application/javascript .js .mjs
AddType text/css .css
AddDefaultCharset UTF-8

RedirectMatch 404 /\.git
RedirectMatch 404 /\.env

# Never serve internal folders, dependency/build files, SQL dumps or logs.
# (database/seed.php used to be runnable by anyone and wiped the database;
#  uploads/ held patient files that could be downloaded without signing in.)
RedirectMatch 404 ^/(database|src|core|includes|config|tests|vendor|node_modules|uploads|logs|\.github)(/|$)
<FilesMatch "(^(composer\.(json|lock)|package(-lock)?\.json|bun\.lock|Dockerfile|docker-compose\.yml|README\.md|server\.log)$|\.(sql|bak|log|ini|sh|dist)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Do not let the browser guess types, and never send wildcard CORS with cookies.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # If assets are requested directly and exist in /assets or /dist/assets, serve directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^assets/(.*)$ dist/assets/$1 [L]
</IfModule>

# --- Performance: compress text and let browsers keep static files ----------
# CSS/JS are linked with ?v=<build>, so a new release changes the URL and a long
# cache is safe. Pages themselves are PHP and are never cached here.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType text/javascript "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(woff2|webp|png|jpe?g|svg|css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# (A global "Access-Control-Allow-Origin: *" was removed: this app is
#  same-origin only and the header served no legitimate purpose.)
